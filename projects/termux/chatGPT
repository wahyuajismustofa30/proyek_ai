#!/data/data/com.termux/files/usr/bin/bash

if [ -z "${OPENAI_API_KEY:-}" ] && [ -f "$HOME/.config/openai.env" ]; then
  source "$HOME/.config/openai.env"
fi

if [ -z "${OPENAI_API_KEY:-}" ]; then
  echo "API key belum ditemukan."
  exit 1
fi

MODEL="gpt-6-luna"
previous_id=""

echo "Chat dengan $MODEL. Ketik /keluar untuk berhenti."

while true; do
  read -r -p "Anda: " prompt
  [ "$prompt" = "/keluar" ] && break
  [ -z "$prompt" ] && continue

  body=$(jq -n \
    --arg model "$MODEL" \
    --arg p "$prompt" \
    --arg prev "$previous_id" \
    'if $prev == "" then
       {model:$model, input:$p}
     else
       {model:$model, previous_response_id:$prev, input:$p}
     end')

  response=$(curl -sS https://api.openai.com/v1/responses \
    -H "Authorization: Bearer $OPENAI_API_KEY" \
    -H "Content-Type: application/json" \
    --data "$body")

  if echo "$response" | jq -e '.error' >/dev/null; then
    echo "$response" | jq -r '.error.message'
  else
    echo "$response" | jq -r \
      '[.output[]?.content[]? | select(.type=="output_text") | .text] | join("\n")'
    previous_id=$(echo "$response" | jq -r '.id // empty')
  fi
done
