#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$HOME/git-repos"

declare -a REPOS=()
declare -a REMOTES=()
declare -a URLS=()
declare -a BRANCHES=()
declare -a NEED_REMOTE=()

# Fail closed: protect the user index and inspect only files that can enter this commit.
security_check_repo() {
    local repo="$1" path base grep_status
    local secret_pattern='-----BEGIN (OPENSSH|RSA|EC|DSA|PRIVATE)( PRIVATE)? KEY-----|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,}|-----BEGIN PGP PRIVATE KEY BLOCK-----'

    if ! git -C "$repo" diff --cached --quiet; then
        echo "[BLOCK] Staged changes already exist; index preserved."
        printf "       Repository: %s\n" "$repo"
        return 1
    fi

    # Check the Git query first so an enumeration failure cannot silently pass.
    if ! git -C "$repo" ls-files --modified --others --exclude-standard -z >/dev/null 2>&1; then
        echo "[BLOCK] Unable to enumerate changed files; repository operation stopped."
        return 1
    fi

    while IFS= read -r -d '' path; do
        base="${path##*/}"
        base="${base,,}"

        # Match known credential filenames, not arbitrary words such as "token".
        if [[ "$base" =~ ^(\.env($|\.)|credentials?([._-].*)?|secrets?([._-].*)?|passwords?([._-].*)?|api[-_.]?key([._-].*)?|access[-_.]?token([._-].*)?|refresh[-_.]?token([._-].*)?|auth[-_.]?(token|credentials?)([._-].*)?|cookie[-_.]?(jar|data)([._-].*)?|session[-_.]?(token|cookie|data)([._-].*)?|tokens?(\.(txt|json|ya?ml|env|conf|config))?|id_(rsa|dsa|ecdsa|ed25519)(.*)|.*\.(pem|key|p12|pfx|keystore|jks|kdbx|ovpn)$|\.netrc$|\.npmrc$|\.pypirc$|terraform\.tfstate(\..*)?)$ ]]; then
            printf '[BLOCK] Suspected sensitive path: %s\n' "$path"
            echo "       Contents are not displayed; repository operation stopped."
            return 1
        fi

        # Skip symlinks to avoid following paths outside the repository.
        if [[ -f "$repo/$path" && ! -L "$repo/$path" ]]; then
            if grep -a -E -q -- "$secret_pattern" "$repo/$path" 2>/dev/null; then
                printf '[BLOCK] Secret/private-key pattern detected: %s\n' "$path"
                echo "       Contents are not displayed; repository operation stopped."
                return 1
            else
                grep_status=$?
                if (( grep_status > 1 )); then
                    printf '[BLOCK] Unable to inspect file safely: %s\n' "$path"
                    echo "       Contents are not displayed; repository operation stopped."
                    return 1
                fi
            fi
        fi
    done < <(git -C "$repo" ls-files --modified --others --exclude-standard -z)

    return 0
}


echo
echo "=========================================="
echo "       GITHUB REPOSITORY MANAGER"
echo "=========================================="
echo "Memindai: $ROOT"
echo

if [[ ! -d "$ROOT" ]]; then
    echo "[GAGAL] Folder utama tidak ditemukan."
    exit 1
fi

# Cari semua repository Git, termasuk yang belum memiliki remote GitHub
while IFS= read -r -d '' gitdir; do
    repo="${gitdir%/.git}"
    top="$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null || true)"
    [[ -n "$top" && "$top" == "$repo" ]] || continue

    selected_remote=""
    selected_url=""
    while IFS= read -r remote; do
        url="$(git -C "$repo" remote get-url "$remote" 2>/dev/null || true)"
        if [[ "$url" =~ github\.com[:/] ]]; then
            if [[ "$remote" == "origin" ]]; then
                selected_remote="$remote"; selected_url="$url"; break
            elif [[ -z "$selected_remote" ]]; then
                selected_remote="$remote"; selected_url="$url"
            fi
        fi
    done < <(git -C "$repo" remote)

    branch="$(git -C "$repo" branch --show-current)"
    [[ -n "$branch" ]] || branch="DETACHED"
    REPOS+=("$repo"); REMOTES+=("$selected_remote")
    URLS+=("$selected_url"); BRANCHES+=("$branch")
    if [[ -z "$selected_remote" ]]; then NEED_REMOTE+=(1); else NEED_REMOTE+=(0); fi
done < <(find "$ROOT" -name .git -prune -print0)

# Folder yang belum berada di dalam repository Git mana pun
declare -a UNINIT=()
while IFS= read -r -d '' dir; do
    [[ -d "$dir" ]] || continue
    # Jangan tawarkan folder yang merupakan bagian dari repository induk
    top="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)"
    [[ -z "$top" ]] || continue
    UNINIT+=("$dir")
done < <(find "$ROOT" -mindepth 1 -type d -not -path '*/.git/*' -not -name .git -print0)

echo "Repository GitHub ditemukan:"
echo
for i in "${!REPOS[@]}"; do
    if [[ "${NEED_REMOTE[$i]}" == "1" ]]; then
        printf " [%d] SETUP/SYNC  %s\n" "$((i + 1))" "${REPOS[$i]#"$ROOT"/}"
        printf "     Branch : %s\n" "${BRANCHES[$i]}"
        printf "     Remote : belum ada remote GitHub\n\n"
    else
        printf " [%d] %s\n" "$((i + 1))" "${REPOS[$i]#"$ROOT"/}"
        printf "     Branch : %s\n" "${BRANCHES[$i]}"
        printf "     Remote : %s\n\n" "${URLS[$i]}"
    fi
done

base=${#REPOS[@]}
if [[ ${#UNINIT[@]} -gt 0 ]]; then
    echo "Folder belum diinisialisasi Git:"
    for i in "${!UNINIT[@]}"; do
        printf " [%d] INIT  %s\n" "$((base + i + 1))" "${UNINIT[$i]#"$ROOT"/}"
    done
    echo
fi

echo " [0] Keluar"
echo
read -rp "Pilih nomor repository / folder: " choice

[[ "$choice" =~ ^[0-9]+$ ]] || {
    echo "Pilihan tidak valid."
    exit 1
}

[[ "$choice" -ne 0 ]] || exit 0
index=$((choice - 1))

# Pilihan folder belum Git: init lokal dan buat repository GitHub
if (( index >= ${#REPOS[@]} && index < ${#REPOS[@]} + ${#UNINIT[@]} )); then
    folder="${UNINIT[$((index - ${#REPOS[@]}))]}"
    repo_name="$(basename "$folder")"

    command -v gh >/dev/null 2>&1 || {
        echo "[GAGAL] GitHub CLI (gh) belum terpasang."
        exit 1
    }
    gh auth status >/dev/null 2>&1 || {
        echo "[GAGAL] GitHub CLI belum login. Jalankan: gh auth login"
        exit 1
    }

    account="$(gh api user --jq .login)"
    echo
    echo "Folder      : $folder"
    echo "Akun GitHub : $account"
    echo "Nama repo   : $repo_name"
    read -rp "Lanjutkan init dan buat repository GitHub? (y/N): " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { echo "Dibatalkan."; exit 0; }

    cd "$folder"
    git init -b main
    security_check_repo "$folder" || exit 1
    git add -A
    if ! git diff --cached --quiet; then
        git diff --cached --check
        git commit -m "Initial commit"
    else
        echo "Folder kosong; repository akan dibuat tanpa commit awal."
    fi

    gh repo create "$account/$repo_name" --private --source="$folder" --remote=origin --push
    echo
    echo "Repository GitHub berhasil dibuat: $account/$repo_name"
    echo "Folder sudah diinisialisasi Git."
    exit 0
fi

if (( index < 0 || index >= ${#REPOS[@]} )); then
    echo "Nomor repository tidak tersedia."
    exit 1
fi

REPO="${REPOS[$index]}"
REMOTE="${REMOTES[$index]}"
URL="${URLS[$index]}"
BRANCH="${BRANCHES[$index]}"

# Git repository lokal tanpa remote GitHub: tawarkan membuat remote dan push.
if [[ "${NEED_REMOTE[$index]}" == "1" ]]; then
    command -v gh >/dev/null 2>&1 || {
        echo "[GAGAL] GitHub CLI (gh) belum terpasang."
        exit 1
    }
    gh auth status >/dev/null 2>&1 || {
        echo "[GAGAL] GitHub CLI belum login. Jalankan: gh auth login"
        exit 1
    }
    account="$(gh api user --jq .login)"
    repo_name="$(basename "$REPO")"
    echo
    echo "Repository lokal : $REPO"
    echo "Akun GitHub    : $account"
    echo "Nama repo      : $repo_name"
    read -rp "Buat remote GitHub dan sinkronkan? (y/N): " confirm
    [[ "$confirm" =~ ^[Yy]$ ]] || { echo "Dibatalkan."; exit 0; }

    repo_full="$account/$repo_name"
    repo_url="https://github.com/$repo_full.git"

    # Repository dengan nama ini mungkin sudah ada di GitHub.
    # Jika ada, hubungkan lokal dan lanjutkan sync, jangan membuat repo duplikat.
    if gh repo view "$repo_full" >/dev/null 2>&1; then
        echo "[INFO] Repository GitHub sudah ada: $repo_full"
        if git -C "$REPO" remote get-url origin >/dev/null 2>&1; then
            git -C "$REPO" remote set-url origin "$repo_url"
        else
            git -C "$REPO" remote add origin "$repo_url"
        fi

        branch_now="$(git -C "$REPO" branch --show-current)"
        if [[ -z "$branch_now" ]]; then
            branch_now="$(gh repo view "$repo_full" --json defaultBranchRef --jq '.defaultBranchRef.name // "main"')"
            git -C "$REPO" switch -c "$branch_now" 2>/dev/null || git -C "$REPO" switch "$branch_now"
        fi
        echo "[OK] Remote origin diarahkan ke $repo_url"
        echo "[INFO] Melanjutkan ke proses sync normal."
        REMOTE="origin"
        URL="$repo_url"
        BRANCH="$(git -C "$REPO" branch --show-current)"
    else
        # Buat repository hanya jika memang belum ada di GitHub.
        security_check_repo "$REPO" || exit 1
        git -C "$REPO" add -A
        if ! git -C "$REPO" diff --cached --quiet; then
            git -C "$REPO" diff --cached --check
            if ! git -C "$REPO" rev-parse --verify HEAD >/dev/null 2>&1; then
                git -C "$REPO" commit -m "Initial commit"
            fi
            gh repo create "$repo_full" --private --source="$REPO" --remote=origin --push
            echo "[OK] Repository GitHub berhasil dibuat dan dipush."
            exit 0
        else
            gh repo create "$repo_full" --private
            git -C "$REPO" remote add origin "$repo_url"
            echo "[INFO] Repository kosong; remote dibuat, belum ada commit untuk push."
            exit 0
        fi
    fi
fi

if [[ "$BRANCH" == "DETACHED" ]]; then
    echo "[GAGAL] Repository berada dalam detached HEAD."
    exit 1
fi

cd "$REPO"

echo
echo "=========================================="
echo "Repository : $REPO"
echo "Branch     : $BRANCH"
echo "Remote     : $REMOTE"
echo "=========================================="

# Pastikan tidak ada operasi Git yang belum selesai
if [[ -d .git/rebase-merge || -d .git/rebase-apply ]] ||
   [[ -f .git/MERGE_HEAD || -f .git/CHERRY_PICK_HEAD ]]; then
    echo "[GAGAL] Ada operasi Git yang belum selesai."
    exit 1
fi

# Periksa perubahan lokal
if [[ -n "$(git status --porcelain)" ]]; then
    echo
    echo "Perubahan lokal ditemukan:"
    git status --short

    echo
    echo "Periksa file di atas sebelum melanjutkan."
    read -rp "Masukkan Y untuk membuat commit otomatis: " confirm

    [[ "$confirm" =~ ^[Yy]$ ]] || {
        echo "Dibatalkan. Tidak ada perubahan yang di-commit."
        exit 0
    }

    security_check_repo "$REPO" || exit 1
    git add -A

    if ! git diff --cached --quiet; then
        echo
        echo "File yang akan dimasukkan ke commit:"
        git diff --cached --name-status

        read -rp "Konfirmasi commit? (y/N): " confirm
        [[ "$confirm" =~ ^[Yy]$ ]] || {
            echo "Dibatalkan. Perubahan staging dipertahankan."
            exit 0
        }

        git diff --cached --check
        git commit -m "Auto sync: $(date '+%Y-%m-%d %H:%M:%S %Z')"
    fi
fi

echo
echo "[1/3] Mengambil perubahan GitHub..."
git fetch "$REMOTE"

echo
echo "[2/3] Memeriksa branch remote..."

if git ls-remote --exit-code --heads "$URL" "$BRANCH" >/dev/null 2>&1; then
    echo "Branch remote ditemukan."
    echo "Melakukan pull dengan rebase..."
    git pull --rebase "$REMOTE" "$BRANCH"
else
    echo "Branch remote belum ditemukan."
    echo "Akan mengirim branch lokal sebagai branch baru."
fi

echo
echo "[3/3] Push ke GitHub..."
git push -u "$REMOTE" "$BRANCH"

echo
echo "=========================================="
echo "       SINKRONISASI BERHASIL"
echo "=========================================="

git status -sb
