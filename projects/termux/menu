#!/usr/bin/env bash

# DEKEKU — Termux Program Menu

BIN="$HOME/bin"

while true; do
    clear

    printf '%s\n' \
        "┌──────────────────────────────────────────────┐" \
        "│               DEKEKU • TERMUX               │" \
        "│              PROGRAM MANAGER                │" \
        "└──────────────────────────────────────────────┘"
    printf '  Host   : %s\n' "$(hostname)"
    printf '  User   : %s\n' "$(whoami)"
    printf '  Waktu  : %s\n' "$(date '+%d-%m-%Y %H:%M:%S')"
    echo

    # Temukan program executable di ~/bin.
    mapfile -d '' PROGRAMS < <(
        find "$BIN" -maxdepth 1 -type f -executable \
            ! -name "menu" ! -name "*.desc" -print0 | sort -z
    )


    echo "  PROGRAM"
    echo "  ─────────────────────────────────────────────"
    if (( ${#PROGRAMS[@]} == 0 )); then
        echo "  Belum ada program tersedia."
    else
        for i in "${!PROGRAMS[@]}"; do
            name="$(basename "${PROGRAMS[$i]}")"
            desc="$BIN/$name.desc"
            printf '  %2d) %-22s' "$((i + 1))" "$name"
            if [[ -f "$desc" ]]; then
                printf ' %s' "$(head -n 1 "$desc")"
            fi
            echo
        done
    fi

    echo
    echo "  ─────────────────────────────────────────────"
    printf '  Total program : %d\n' "${#PROGRAMS[@]}"
    echo "  [R] Muat ulang daftar"
    echo "  [0] Keluar"
    echo

    read -rp "  Pilihan > " choice

    case "$choice" in
        0)
            clear
            echo "DEKEKU • Menu ditutup."
            exit 0
            ;;
        r|R)
            continue
            ;;
        *)
            if [[ "$choice" =~ ^[0-9]+$ ]] &&
               (( choice >= 1 && choice <= ${#PROGRAMS[@]} )); then
                selected="${PROGRAMS[$((choice - 1))]}"
                clear
                echo "┌──────────────────────────────────────────────┐"
                echo "│                MENJALANKAN                 │"
                echo "└──────────────────────────────────────────────┘"
                printf '  Program : %s\n' "$(basename "$selected")"
                printf '  Path    : %s\n' "$selected"
                echo "  ─────────────────────────────────────────────"
                if [[ "$selected" == "$AUDIT_SCRIPT" ]]; then
                    python3 "$selected"
                    result=$?
                else
                    "$selected"
                    result=$?
                fi
                echo
                echo "  ─────────────────────────────────────────────"
                printf '  Program selesai (exit: %d).\n' "$result"
                read -rp "  Enter untuk kembali ke menu..."
            else
                echo "  Pilihan tidak valid."
                sleep 1
            fi
            ;;
    esac
done
