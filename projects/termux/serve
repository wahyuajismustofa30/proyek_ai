#!/data/data/com.termux/files/usr/bin/bash

# Local HTTP Server for Termux

PORT="${2:-8000}"
DIR="${1:-$PWD}"

# Validasi folder
if [ ! -d "$DIR" ]; then
    echo "[ERROR] Folder tidak ditemukan: $DIR"
    exit 1
fi

# Validasi port
if ! [[ "$PORT" =~ ^[0-9]+$ ]] || \
   [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
    echo "[ERROR] Port harus antara 1-65535"
    exit 1
fi

# Cek port
if python -c "import socket,sys; s=socket.socket(); r=s.connect_ex(('127.0.0.1',$PORT)); s.close(); sys.exit(0 if r else 1)"; then
    echo "[INFO] Port $PORT tersedia."
else
    echo "[ERROR] Port $PORT sedang digunakan."
    exit 1
fi

DIR="$(realpath "$DIR")"

echo ""
echo "================================"
echo "       TERMUX LOCAL SERVER"
echo "================================"
echo "Folder : $DIR"
echo "Port   : $PORT"
echo "URL    : http://localhost:$PORT"
echo "================================"
echo "Tekan CTRL+C untuk menghentikan."
echo ""

python -m http.server "$PORT" \
    --bind 127.0.0.1 \
    --directory "$DIR"
