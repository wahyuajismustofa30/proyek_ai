#!/data/data/com.termux/files/usr/bin/bash

set -euo pipefail

SOURCE="$HOME/"
DEST="$HOME/storage/shared/TERMUX/HOME/"

if [[ ! -d "$HOME/storage/shared/TERMUX" ]]; then
    echo "ERROR: Akses penyimpanan belum tersedia."
    echo "Jalankan: termux-setup-storage"
    exit 1
fi

command -v rsync >/dev/null 2>&1 || {
    echo "ERROR: rsync tidak tersedia."
    exit 1
}

mkdir -p "$DEST"

echo "================================"
echo " DEKEKU TERMUX HOME SYNC"
echo "================================"
echo "Sumber : $SOURCE"
echo "Tujuan : $DEST"
echo
echo "Perlindungan secret aktif; file sensitif tidak akan disalin."
echo

rsync -rhv \
    --human-readable \
    --exclude='storage/' \
    --exclude='.ssh/' \
    --exclude='.gnupg/' \
    --exclude='.cache/' \
    --exclude='.npm/' \
    --exclude='node_modules/' \
    --exclude='.git-credentials' \
    --exclude='.netrc' \
    --exclude='.bash_history' \
    --exclude='.config/gh/' \
    --exclude='.config/gcloud/' \
    --exclude='.config/azure/' \
    --exclude='.config/1Password/' \
    --exclude='.config/Bitwarden/' \
    --exclude='.config/gh-hosts.yml' \
    --exclude='.config/gopass/' \
    --exclude='.config/sops/' \
    --exclude='.config/age/' \
    --exclude='.config/containers/' \
    --exclude='.config/rclone/' \
    --exclude='.config/terraform.d/' \
    --exclude='.config/Cloudflare/' \
    --exclude='.config/cloudflared/' \
    --exclude='.config/termux/' \
    --exclude='.local/share/gh/' \
    --exclude='.local/share/cloudflared/' \
    --exclude='.local/share/termux/' \
    --exclude='.local/share/keyrings/' \
    --exclude='.local/share/password-store/' \
    --exclude='.local/share/containers/' \
    --exclude='.local/share/rclone/' \
    --exclude='.local/share/terraform/' \
    --exclude='.config/openai.env' \
    --exclude='.config/*credentials*' \
    --exclude='.config/*token*' \
    --exclude='.config/*secret*' \
    --exclude='.aws/' \
    --exclude='.azure/' \
    --exclude='.docker/config.json' \
    --exclude='.local/share/keyrings/' \
    --exclude='.local/share/*/credentials*' \
    --exclude='.local/share/*/token*' \
    --exclude='.password-store/' \
    --exclude='.pypirc' \
    --exclude='.npmrc' \
    --exclude='.netrc' \
    --exclude='*.pem' \
    --exclude='*.p12' \
    --exclude='*.pfx' \
    --exclude='*.keystore' \
    --exclude='*.jks' \
    --exclude='*.kdbx' \
    --exclude='*.ovpn' \
    --exclude='*.cookie' \
    --exclude='*.session' \
    --exclude='*.secret' \
    --exclude='*.secrets' \
    --exclude='*.env' \
    --exclude='*.env.*' \
    --exclude='*.tfstate' \
    --exclude='*.tfstate.*' \
    --exclude='*.sqlite' \
    --exclude='*.sqlite3' \
    --exclude='*.key' \
    --exclude='id_rsa*' \
    --exclude='id_ed25519*' \
    --exclude='*credentials.json' \
    --exclude='*service-account*.json' \
    --exclude='*secret*' \
    --exclude='*token*' \
    "$SOURCE" "$DEST"

echo
echo "Sinkronisasi selesai."
