def write_worker_state(path, metadata, **updates):
    metadata.update(updates)
    try:
        atomic_write_json(path, metadata)
    except OSError:
        pass


def worker_main(token, path):
    # Parent publishes the metadata only after it knows the worker PID.
    deadline = time.monotonic() + 10
    metadata = None
    while time.monotonic() < deadline:
        candidate, error = read_metadata(path)
        if candidate and candidate.get("token") == token and candidate.get("pid") == os.getpid():
            metadata = candidate
            break
        time.sleep(0.1)
    if metadata is None:
        return 2

    stopping = {"requested": False}

    def request_stop(_signum, _frame):
        stopping["requested"] = True

    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)

    try:
        command = server_command(metadata["engine"], metadata["port"], metadata["project"])
        with open(metadata["log"], "ab") as log:
            child = subprocess.Popen(
                command,
                cwd=metadata["project"],
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=subprocess.STDOUT,
                close_fds=True,
            )
            write_worker_state(path, metadata, server_pid=child.pid, state="RUNNING")
            while child.poll() is None and not stopping["requested"]:
                time.sleep(0.2)
            if stopping["requested"] and child.poll() is None:
                write_worker_state(path, metadata, state="STOPPING")
                child.terminate()
                try:
                    child.wait(timeout=4)
                except subprocess.TimeoutExpired:
                    child.kill()
                    child.wait()
            exit_code = child.wait()
            write_worker_state(
                path, metadata, state="STOPPED", exit_code=exit_code,
                ended_at=now_iso(),
            )
            return 0 if exit_code == 0 or stopping["requested"] else exit_code
    except Exception as error:
        write_worker_state(path, metadata, state="FAILED", error=str(error), ended_at=now_iso())
        return 1



def load_saved_projects():
    if not os.path.exists(PROJECTS_FILE):
        initial = {"schema": 1, "projects": []}
        try:
            save_saved_projects(initial)
            return initial, None
        except (OSError, ValueError) as error:
            return None, str(error)
    try:
        with open(PROJECTS_FILE, encoding="utf-8") as stream:
            data = json.load(stream)
        if not isinstance(data, dict) or data.get("schema") != 1 or not isinstance(data.get("projects"), list):
            raise ValueError("struktur atau versi skema tidak didukung")
        seen_ids, seen_paths, seen_ports = set(), set(), set()
        for item in data["projects"]:
            if not isinstance(item, dict):
                raise ValueError("entri proyek bukan objek")
            required = ("id", "name", "path", "port", "engine", "created_at")
            if any(key not in item for key in required):
                raise ValueError("field entri proyek tidak lengkap")
            if not isinstance(item["id"], str) or not item["id"]:
                raise ValueError("ID proyek tidak valid")
            if not isinstance(item["name"], str) or not item["name"].strip():
                raise ValueError("nama proyek tidak valid")
            if not isinstance(item["path"], str) or not os.path.isabs(item["path"]):
                raise ValueError("path proyek tidak valid")
            if not isinstance(item["port"], int) or isinstance(item["port"], bool) or not (1 <= item["port"] <= 65535):
                raise ValueError("port proyek tidak valid")
            if item["engine"] not in ("php", "html"):
                raise ValueError("jenis server tidak valid")
            normalized = os.path.realpath(item["path"])
            if item["id"] in seen_ids or normalized in seen_paths or item["port"] in seen_ports:
                raise ValueError("terdapat ID, path, atau port duplikat")
            seen_ids.add(item["id"])
            seen_paths.add(normalized)
            seen_ports.add(item["port"])
        return data, None
    except (OSError, ValueError, TypeError, json.JSONDecodeError) as error:
        return None, str(error)


def save_saved_projects(data):
    if not isinstance(data, dict) or data.get("schema") != 1 or not isinstance(data.get("projects"), list):
        raise ValueError("struktur konfigurasi proyek tidak valid")
    atomic_write_json(PROJECTS_FILE, data)


def saved_project_conflict(path, port, exclude_id=None):
    data, error = load_saved_projects()
    if error:
        return f"Konfigurasi proyek tersimpan rusak: {error}"
    normalized = os.path.realpath(path)
    for item in data["projects"]:
        if item["id"] == exclude_id:
            continue
        if os.path.realpath(item["path"]) == normalized:
            return f"Folder sudah tersimpan sebagai '{item['name']}'."
        if item["port"] == port:
            return f"Port {port} sudah digunakan konfigurasi '{item['name']}'."
    return None


def save_project_entry(folder, port, engine, name=None):
    data, error = load_saved_projects()
    if error:
        print(f"Tidak dapat menyimpan: konfigurasi tersimpan rusak ({error}).")
        return False
    conflict = saved_project_conflict(folder, port)
    if conflict:
        print(conflict)
        return False
    entry = {
        "id": secrets.token_hex(8),
        "name": (name or os.path.basename(folder.rstrip(os.sep)) or folder).strip(),
        "path": os.path.realpath(folder),
        "port": port,
        "engine": engine,
        "created_at": now_iso(),
    }
    data["projects"].append(entry)
    try:
        save_saved_projects(data)
        print(f"Proyek '{entry['name']}' berhasil disimpan.")
        return True
    except (OSError, ValueError) as error:
        print(f"Gagal menyimpan proyek: {error}")
        return False


def saved_server_status(project):
    path = metadata_path(project["port"])
    if not os.path.isfile(path):
        return "BERHENTI"
    data, error = read_metadata(path)
    if error:
        return "TIDAK DAPAT DIVERIFIKASI"
    if os.path.realpath(data.get("project", "")) != os.path.realpath(project["path"]):
        return "PORT DIPAKAI KONFIGURASI LAIN"
    return describe_status(data)


def list_saved_projects(data=None):
    if data is None:
        data, error = load_saved_projects()
        if error:
            print(f"Konfigurasi proyek tidak dapat dibaca: {error}")
            return None
    if not data["projects"]:
        print("Belum ada proyek tersimpan.")
        return []
    print("\nPROYEK TERSIMPAN")
    for index, item in enumerate(data["projects"], 1):
        folder_status = "TERSEDIA" if os.path.isdir(item["path"]) else "TIDAK DITEMUKAN"
        print(f"{index}. {item['name']}")
        print(f"   Port: {item['port']} | Engine: {item['engine'].upper()}")
        print(f"   Folder: {folder_status}")
        print(f"   Server: {saved_server_status(item)}")
        print(f"   Path: {item['path']}")
    return data["projects"]


def choose_saved_project():
    data, error = load_saved_projects()
    if error:
        print(f"Konfigurasi proyek tidak dapat dibaca: {error}")
        return
    projects = list_saved_projects(data)
    if not projects:
        return
    choice = input("\nPilih proyek (0 batal): ").strip()
    if not choice.isdigit() or int(choice) == 0 or int(choice) > len(projects):
        return
    item = projects[int(choice) - 1]
    if not os.path.isdir(item["path"]):
        print("Folder proyek tidak ditemukan. Konfigurasi tetap disimpan.")
        if input("Ubah path sekarang? (y/n): ").strip().lower() == "y":
            update_saved_path(item)
        return
    start_server(saved_project=item)


def update_saved_path(item):
    new_path = os.path.realpath(os.path.abspath(os.path.expanduser(input("Path folder baru: ").strip())))
    if not os.path.isdir(new_path):
        print("Folder tidak ditemukan.")
        return False
    engine = detect_engine(new_path)
    if not engine:
        print("Folder tidak memiliki file PHP/HTML/HTM yang didukung.")
        return False
    conflict = saved_project_conflict(new_path, item["port"], exclude_id=item["id"])
    if conflict:
        print(conflict)
        return False
    data, error = load_saved_projects()
    if error:
        print(f"Konfigurasi tidak dapat dibaca: {error}")
        return False
    for entry in data["projects"]:
        if entry["id"] == item["id"]:
            entry["path"] = new_path
            entry["engine"] = engine
            break
    try:
        save_saved_projects(data)
        print("Path proyek berhasil diperbarui.")
        return True
    except (OSError, ValueError) as error:
        print(f"Gagal memperbarui path: {error}")
        return False


def add_saved_project():
    folder = choose_project()
    if not folder:
        return
    if not os.path.isdir(folder):
        print("Folder proyek tidak ditemukan.")
        return
    engine = detect_engine(folder)
    if not engine:
        print("Folder proyek tidak memiliki file PHP, HTML, atau HTM.")
        return
    port = get_project_port(folder)
    if not port:
        return
    name = input(f"Nama proyek [{os.path.basename(folder)}]: ").strip()
    save_project_entry(folder, port, engine, name or None)


def manage_saved_projects():
    data, error = load_saved_projects()
    if error:
        print(f"Konfigurasi proyek tidak dapat dibaca: {error}")
        print("File asli dipertahankan. Perbaiki atau pulihkan JSON secara manual.")
        return
    projects = list_saved_projects(data)
    if not projects:
        return
    choice = input("\nPilih proyek untuk dikelola (0 batal): ").strip()
    if not choice.isdigit() or int(choice) == 0 or int(choice) > len(projects):
        return
    item = projects[int(choice) - 1]
    print("\n1. Ubah nama\n2. Ubah path folder\n3. Ubah port\n4. Lihat detail\n5. Hapus dari daftar\n6. Tambah proyek\n0. Kembali")
    action = input("Pilih tindakan: ").strip()
    if action == "6":
        add_saved_project()
        return
    if action == "1":
        name = input("Nama baru: ").strip()
        if not name:
            print("Nama tidak boleh kosong.")
            return
        item["name"] = name
    elif action == "2":
        update_saved_path(item)
        return
    elif action == "3":
        raw = input("Port baru: ").strip()
        port = parse_port_value(raw)
        if not port:
            print("Port tidak valid (1–65535).")
            return
        conflict = saved_project_conflict(item["path"], port, exclude_id=item["id"])
        if conflict:
            print(conflict)
            return
        item["port"] = port
    elif action == "4":
        print(json.dumps(item, ensure_ascii=False, indent=2))
        return
    elif action == "5":
        active_status = saved_server_status(item)
        if active_status in ("AKTIF", "MEMULAI / MENGHENTIKAN", "TIDAK DAPAT DIVERIFIKASI"):
            print(f"Catatan: server berstatus {active_status}; penghapusan konfigurasi tidak menghentikannya.")
        if input(f"Hapus '{item['name']}' dari daftar tersimpan? (y/n): ").strip().lower() != "y":
            print("Dibatalkan.")
            return
        data["projects"] = [entry for entry in data["projects"] if entry["id"] != item["id"]]
        try:
            save_saved_projects(data)
            print("Konfigurasi dihapus. Folder, file PORT, dan server tidak diubah.")
        except (OSError, ValueError) as error:
            print(f"Gagal menghapus konfigurasi: {error}")
        return
    elif action == "0":
        return
    else:
        print("Pilihan tidak valid.")
        return
    try:
        save_saved_projects(data)
        print("Konfigurasi proyek berhasil diperbarui.")
    except (OSError, ValueError) as error:
        print(f"Gagal menyimpan perubahan: {error}")


def start_server(saved_project=None):
    if saved_project:
        folder = os.path.realpath(saved_project["path"])
        port = saved_project["port"]
        if not isinstance(port, int) or isinstance(port, bool) or not (1 <= port <= 65535):
            print("Port proyek tersimpan tidak valid.")
            return
        engine = detect_engine(folder)
        if not engine:
            print("Folder proyek tidak memiliki file PHP, HTML, atau HTM.")
            return
        config_port = None
        for filename in ("PORT", ".webport"):
            config_path = os.path.join(folder, filename)
            if os.path.isfile(config_path):
                try:
                    with open(config_path, encoding="utf-8") as stream:
                        config_port = next((parse_port_value(line) for line in stream if line.strip() and not line.lstrip().startswith("#")), None)
                except OSError as error:
                    print(f"Tidak dapat membaca {filename}: {error}")
                    return
                if config_port is None:
                    print(f"Peringatan: konfigurasi {filename} tidak valid. Port tersimpan tetap {port}.")
                    if input("Tetap lanjut menggunakan port tersimpan? (y/n): ").strip().lower() != "y":
                        print("Dibatalkan.")
                        return
                break
        if config_port and config_port != port:
            print(f"Peringatan: konfigurasi tersimpan memakai port {port}, tetapi {filename} berisi port {config_port}.")
            if input("Tetap jalankan menggunakan port tersimpan? (y/n): ").strip().lower() != "y":
                print("Dibatalkan.")
                return
    else:
        folder = choose_project()
        if not folder:
            return
        if not os.path.isdir(folder):
            print("Folder proyek tidak ditemukan.")
            return
        engine = detect_engine(folder)
        if not engine:
            print("Folder proyek tidak memiliki file PHP, HTML, atau HTM.")
            return
        port = get_project_port(folder)
        if not port:
            return
        if input("Simpan folder dan port ini untuk digunakan kembali? (y/n): ").strip().lower() == "y":
            save_project_entry(folder, port, engine)

    path = metadata_path(port)
    if os.path.exists(path):
        old, error = read_metadata(path)
        if error:
            print(f"Metadata port {port} rusak; file dipertahankan: {error}")
            return
        identity = process_identity(old["pid"], old["token"])
        if identity is True or identity is None:
            print(f"Port {port} sudah memiliki proses Webport ({describe_status(old)}).")
            return
        # Stale metadata belongs to an exited worker or a reused PID.
        try:
            os.unlink(path)
        except OSError as error:
            print(f"Tidak dapat membersihkan metadata lama: {error}")
            return

    if not port_is_available(port):
        print(f"Port {port} sudah digunakan atau tidak dapat di-bind.")
        print("Webport tidak mencoba mengidentifikasi atau menghentikan proses tersebut.")
        return

    try:
        ensure_runtime_dir(SERVERS_DIR)
        log_path = os.path.join(DATA, f"{port}.log")
        token = secrets.token_hex(24)
        metadata = {
            "schema": 1,
            "pid": 0,
            "token": token,
            "server_pid": None,
            "port": port,
            "engine": engine,
            "project": folder,
            "log": log_path,
            "state": "STARTING",
            "started_at": now_iso(),
        }
        with open(log_path, "ab") as log:
            worker = subprocess.Popen(
                [sys.executable, SCRIPT_PATH, "--webport-worker", token, path],
                stdin=subprocess.DEVNULL,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                close_fds=True,
            )
        metadata["pid"] = worker.pid
        atomic_write_json(path, metadata)

        deadline = time.monotonic() + WORKER_READY_TIMEOUT
        current = None
        while time.monotonic() < deadline:
            current, error = read_metadata(path)
            if current and current.get("token") == token:
                if current.get("state") in ("FAILED", "STOPPED"):
                    break
                if current.get("state") == "RUNNING" and port_accepts_connections(port):
                    break
            if process_identity(worker.pid, token) is False:
                break
            time.sleep(0.1)

        if current and current.get("token") == token and current.get("state") == "RUNNING" and port_accepts_connections(port) and process_identity(worker.pid, token) is True:
            print("\nSERVER BERHASIL DIJALANKAN")
            print("-" * 48)
            print("Proyek :", os.path.basename(folder))
            print("Folder :", folder)
            print("Engine :", engine.upper())
            print("Port   :", port)
            print("PID    :", worker.pid)
            print("URL    :", f"http://127.0.0.1:{port}")
            print("LAN    :", f"http://0.0.0.0:{port}")
            print("Log    :", log_path)
            return

        print("Server gagal mencapai status aktif.")
        if current and current.get("error"):
            print("Alasan:", current["error"])
        print("Periksa log:", log_path)
        if process_identity(worker.pid, token) is True:
            stop_managed_server(metadata, path, quiet=True)
    except OSError as error:
        print(f"Gagal menjalankan Webport: {error}")
    except Exception as error:
        print(f"Kesalahan saat menyiapkan server: {error}")


def stop_managed_server(metadata, path, quiet=False):
    pid = metadata["pid"]
    token = metadata["token"]
    identity = process_identity(pid, token)
    if identity is False:
        if not quiet:
            print("Server sudah berhenti atau PID sudah digunakan proses lain.")
        return identity
    if identity is None:
        if not quiet:
            print("Identitas proses tidak dapat diverifikasi. Tidak ada sinyal yang dikirim.")
        return identity

    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        if not quiet:
            print("Server sudah berhenti.")
        return False
    except PermissionError:
        if not quiet:
            print("Tidak memiliki izin untuk menghentikan server.")
        return None
    except OSError as error:
        if not quiet:
            print(f"Gagal mengirim SIGTERM: {error}")
        return None

    deadline = time.monotonic() + STOP_TIMEOUT
    while time.monotonic() < deadline:
        identity = process_identity(pid, token)
        if identity is False:
            if not quiet:
                print(f"Server pada port {metadata['port']} berhasil dihentikan.")
            return False
        if identity is None:
            if not quiet:
                print("Status proses tidak dapat diverifikasi setelah SIGTERM.")
            return None
        time.sleep(0.2)

    # Last resort: the worker created a dedicated session/process group.
    # Revalidate ownership and group leadership immediately before SIGKILL.
    if process_identity(pid, token) is True:
        try:
            if os.getpgid(pid) != pid:
                if not quiet:
                    print("Process group tidak cocok; SIGKILL dibatalkan demi keamanan.")
                return None
            os.killpg(pid, signal.SIGKILL)
            time.sleep(0.2)
            if process_identity(pid, token) is False:
                if not quiet:
                    print(f"Server pada port {metadata['port']} dihentikan dengan SIGKILL.")
                return False
        except (OSError, ProcessLookupError) as error:
            if not quiet:
                print(f"Gagal melakukan penghentian terakhir: {error}")
            return None
    if not quiet:
        print("Server belum dapat dipastikan berhenti. Metadata dipertahankan.")
    return None


def stop_port():
    records = []
    for path, data, error in load_managed_servers():
        if error:
            continue
        status = describe_status(data)
        if status in ("AKTIF", "MEMULAI / MENGHENTIKAN", "TIDAK DAPAT DIVERIFIKASI", "MEMULAI / TIDAK DAPAT DIVERIFIKASI"):
            records.append((path, data, status))

    if not records:
        print("Tidak ada server Webport yang dapat dipilih untuk dihentikan.")
        return

    print("\nSERVER WEBPORT")
    for index, (_path, data, status) in enumerate(records, 1):
        print(f"{index}. Port {data['port']} | {os.path.basename(data['project'])} | PID {data['pid']} | {status}")
    choice = input("\nPilih server (0 batal): ").strip()
    if not choice.isdigit() or int(choice) == 0 or int(choice) > len(records):
        return
    path, data, status = records[int(choice) - 1]
    if status not in ("AKTIF", "MEMULAI / MENGHENTIKAN"):
        print("Status tidak cukup terverifikasi. Proses tidak dihentikan.")
        return
    confirm = input(f"Hentikan server port {data['port']}? (y/n): ").strip().lower()
    if confirm != "y":
        print("Dibatalkan.")
        return
    result = stop_managed_server(data, path)
    if result is False:
        # Keep the record as a stopped entry for status/history; no data is removed.
        return


