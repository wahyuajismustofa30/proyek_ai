#!/data/data/com.termux/files/usr/bin/bash

# repo-programs
# Menu interaktif untuk menjalankan program operasional di scripts/.

SCRIPT_PATH="$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")"
SCRIPT_DIR="$(cd -- "$(dirname -- "$SCRIPT_PATH")" && pwd -P)"
REPO="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null)"
if [[ -z "$REPO" ]]; then
    REPO="$(cd -- "$SCRIPT_DIR/.." && pwd -P)"
fi
ROOT="$REPO/scripts"
PROJECTS_ROOT="$REPO/projects"
SELF="$SCRIPT_PATH"

declare -a PROGRAM_PATHS PROGRAM_NAMES PROGRAM_TYPES PROGRAM_COMMANDS

detect_program() {
    local file="$1" ext first_line
    ext="${file##*.}"
    ext="${ext,,}"
    first_line="$(head -n 1 "$file" 2>/dev/null)"

    TYPE=""
    COMMAND=""
    case "$ext" in
        sh)         TYPE="Shell"; COMMAND="bash" ;;
        bash)       TYPE="Bash"; COMMAND="bash" ;;
        py)         TYPE="Python"; COMMAND="python3" ;;
        php)        TYPE="PHP"; COMMAND="php" ;;
        js|mjs|cjs) TYPE="JavaScript"; COMMAND="node" ;;
        rb)         TYPE="Ruby"; COMMAND="ruby" ;;
        pl)         TYPE="Perl"; COMMAND="perl" ;;
        lua)        TYPE="Lua"; COMMAND="lua" ;;
        r)          TYPE="R"; COMMAND="Rscript" ;;
    esac

    if [[ -z "$COMMAND" && "$first_line" == '#!'* ]]; then
        case "$first_line" in
            *python*)  TYPE="Python"; COMMAND="python3" ;;
            *bash*)    TYPE="Bash"; COMMAND="bash" ;;
            *"/sh"*)   TYPE="Shell"; COMMAND="sh" ;;
            *php*)     TYPE="PHP"; COMMAND="php" ;;
            *node*)    TYPE="JavaScript"; COMMAND="node" ;;
            *ruby*)    TYPE="Ruby"; COMMAND="ruby" ;;
            *perl*)    TYPE="Perl"; COMMAND="perl" ;;
            *lua*)     TYPE="Lua"; COMMAND="lua" ;;
            *Rscript*) TYPE="R"; COMMAND="Rscript" ;;
        esac
    fi
    [[ -n "$COMMAND" ]]
}

scan_programs() {
    local file relative
    PROGRAM_PATHS=()
    PROGRAM_NAMES=()
    PROGRAM_TYPES=()
    PROGRAM_COMMANDS=()

    if [[ ! -d "$ROOT" ]]; then
        printf '[ERROR] Folder scripts tidak ditemukan: %s\n' "$ROOT"
        return 1
    fi

    while IFS= read -r -d '' file; do
        [[ "$file" == "$SELF" ]] && continue
        relative="${file#"$ROOT"/}"
        case "/$relative/" in
            */tests/*|*/.git/*|*/__pycache__/*) continue ;;
        esac

        if detect_program "$file"; then
            PROGRAM_PATHS+=("$file")
            PROGRAM_NAMES+=("$relative")
            PROGRAM_TYPES+=("$TYPE")
            PROGRAM_COMMANDS+=("$COMMAND")
        fi
    done < <(find "$ROOT" -type f -print0 | sort -z)
}

show_menu() {
    local i number interpreter status
    clear 2>/dev/null || true
    printf '%s\n' '=============================================='
    printf '%s\n' '          PROYEK_AI PROGRAM MANAGER'
    printf '%s\n' '=============================================='
    printf 'Repository: proyek_ai  |  Direktori: scripts/\n'
    printf '%s\n' '----------------------------------------------'
    printf 'DAFTAR PROGRAM (%d)\n\n' "${#PROGRAM_PATHS[@]}"

    if (( ${#PROGRAM_PATHS[@]} == 0 )); then
        printf '%s\n' 'Belum ditemukan program operasional.'
    else
        for i in "${!PROGRAM_PATHS[@]}"; do
            number=$((i + 1))
            interpreter="${PROGRAM_COMMANDS[$i]}"
            if command -v "$interpreter" >/dev/null 2>&1; then
                status="OK"
            else
                status="NO INTERPRETER"
            fi
            printf '[%02d] %-42s %-12s %s\n' \
                "$number" "${PROGRAM_NAMES[$i]}" "${PROGRAM_TYPES[$i]}" "$status"
        done
    fi

    printf '\n%s\n' '----------------------------------------------'
    printf '%s\n' '[R] Refresh daftar    [0] Keluar'
    printf '%s\n' '=============================================='
}

select_project() {
    local prompt="$1" mode="$2" dir existing choice skip
    local -a projects=()

    if [[ ! -d "$PROJECTS_ROOT" ]]; then
        printf '[ERROR] Folder projects tidak ditemukan: %s\n' "$PROJECTS_ROOT" >&2
        return 1
    fi

    while IFS= read -r -d '' dir; do
        case "$mode" in
            node)
                [[ -f "$dir/package.json" ]] || continue
                ;;
            python)
                if [[ ! -f "$dir/pyproject.toml" &&
                      ! -f "$dir/requirements.txt" &&
                      ! -f "$dir/requirements-test.txt" &&
                      ! -f "$dir/requirements-dev.txt" ]]; then
                    [[ -d "$dir/tests" ]] || continue
                    find "$dir/tests" -maxdepth 1 -type f \
                        \( -name 'test_*.py' -o -name '*_test.py' \) \
                        -print -quit | grep -q . || continue
                fi
                ;;
            php)
                [[ -f "$dir/composer.json" ]] || continue
                ;;
            static|web)
                [[ -f "$dir/index.html" ]] || continue
                ;;
            *)
                printf '[ERROR] Jenis proyek tidak dikenal: %s\n' "$mode" >&2
                return 2
                ;;
        esac

        skip=0
        for existing in "${projects[@]}"; do
            if [[ "$dir" == "$existing/"* ]]; then
                skip=1
                break
            fi
        done
        (( skip == 0 )) && projects+=("$dir")
    done < <(
        find "$PROJECTS_ROOT" -mindepth 1 \
            \( -name .git -o -name node_modules -o -name vendor \
               -o -name .venv -o -name venv -o -name __pycache__ \) -prune \
            -o -type d -print0
    )

    if (( ${#projects[@]} == 0 )); then
        printf '[ERROR] Tidak ada proyek yang cocok untuk jenis "%s".\n' "$mode" >&2
        return 1
    fi

    printf '\n%s\n' "$prompt"
    for i in "${!projects[@]}"; do
        printf '[%02d] %s\n' "$((i + 1))" "${projects[$i]#"$REPO"/}"
    done
    printf '[0] Batal\n'
    read -r -p 'Pilih proyek: ' choice
    [[ "$choice" =~ ^[0-9]+$ ]] || {
        printf '[ERROR] Pilihan tidak valid.\n' >&2
        return 1
    }
    (( choice == 0 )) && return 1
    (( choice >= 1 && choice <= ${#projects[@]} )) || {
        printf '[ERROR] Pilihan di luar daftar.\n' >&2
        return 1
    }
    SELECTED_PROJECT="${projects[$((choice - 1))]}"
}

run_selected() {
    local file="$1" name="$2" interpreter="$3"
    local project stack action entrypoint mode choice program
    local -a args=()
    program="$(basename -- "$name")"

    case "$program" in
        run_project_checks.py)
            printf '\nStack yang akan diperiksa:\n[1] Node.js\n[2] Python\n[3] PHP\n[0] Batal\n'
            read -r -p 'Pilih stack: ' choice
            case "$choice" in
                1) stack="node" ;;
                2) stack="python" ;;
                3) stack="php" ;;
                0) return 0 ;;
                *) printf '[ERROR] Pilihan stack tidak valid.\n'; return 2 ;;
            esac
            select_project 'Pilih direktori proyek:' "$stack" || return 0
            project="${SELECTED_PROJECT#"$REPO"/}"
            args=("$stack" "$project")
            ;;
        update_project_index.py)
            printf '\nTindakan indeks proyek:\n[1] Periksa (--check, aman/tidak mengubah file)\n[2] Perbarui (--write)\n[0] Batal\n'
            read -r -p 'Pilih tindakan: ' action
            case "$action" in
                1) args=(--check --root "$REPO") ;;
                2) args=(--write --root "$REPO") ;;
                0) return 0 ;;
                *) printf '[ERROR] Pilihan tindakan tidak valid.\n'; return 2 ;;
            esac
            ;;
        check_static_site.py)
            select_project 'Pilih direktori website statis:' static || return 0
            read -r -p 'Nama entrypoint [index.html]: ' entrypoint
            entrypoint="${entrypoint:-index.html}"
            args=("$SELECTED_PROJECT" --entrypoint "$entrypoint")
            ;;
        validate_web_projects.py)
            printf '\nValidasi proyek web:\n[1] Semua proyek (default)\n[2] Pilih satu proyek\n[0] Batal\n'
            read -r -p 'Pilih cakupan: ' mode
            case "$mode" in
                1|'') args=(--root "$REPO") ;;
                2)
                    select_project 'Pilih proyek web:' web || return 0
                    args=("$SELECTED_PROJECT" --root "$REPO")
                    ;;
                0) return 0 ;;
                *) printf '[ERROR] Pilihan cakupan tidak valid.\n'; return 2 ;;
            esac
            ;;
        discover_projects.py)
            args=(--root "$REPO")
            ;;
    esac

    printf '\n==============================================\n'
    printf 'Menjalankan: %s\n' "$name"
    printf '==============================================\n\n'
    "$interpreter" "$file" "${args[@]}"
    return $?
}

if [[ ! -d "$REPO/.git" && ! -f "$REPO/.git" ]]; then
    printf '[ERROR] Repository tidak ditemukan: %s\n' "$REPO"
    printf 'Pastikan menu dijalankan dari dalam repository proyek_ai.\n'
    exit 1
fi

while true; do
    scan_programs || exit 1
    show_menu
    read -r -p 'Pilih program: ' choice

    case "$choice" in
        0)
            printf '%s\n' 'Keluar dari repo-programs.'
            exit 0
            ;;
        r|R) continue ;;
        *)
            if [[ ! "$choice" =~ ^[0-9]+$ ]] ||
                (( choice < 1 || choice > ${#PROGRAM_PATHS[@]} )); then
                printf '\n%s\n' '[ERROR] Pilihan tidak valid.'
                read -r -p 'Tekan Enter untuk melanjutkan...'
                continue
            fi
            ;;
    esac

    index=$((choice - 1))
    file="${PROGRAM_PATHS[$index]}"
    name="${PROGRAM_NAMES[$index]}"
    interpreter="${PROGRAM_COMMANDS[$index]}"

    if [[ ! -f "$file" ]]; then
        printf '[ERROR] File program tidak ditemukan: %s\n' "$file"
    elif ! command -v "$interpreter" >/dev/null 2>&1; then
        printf '[ERROR] Interpreter "%s" belum tersedia.\n' "$interpreter"
    else
        cd "$REPO" || exit 1
        run_selected "$file" "$name" "$interpreter"
        result=$?
        printf '\n----------------------------------------------\n'
        printf 'Program selesai dengan kode: %d\n' "$result"
    fi

    printf '\n'
    read -r -p 'Tekan Enter untuk kembali ke menu...'
done
